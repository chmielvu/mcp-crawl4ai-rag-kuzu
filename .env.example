# MCP server transport
TRANSPORT=sse
HOST=0.0.0.0
PORT=8051

# Playwright browsers path (set automatically if .venv/playwright exists)
# PLAYWRIGHT_BROWSERS_PATH=./.venv/playwright

# Mistral AI
MISTRAL_API_KEY=6AHIhtlP62Uukt0OSUoF6i7AvJuYIIfb
MODEL_CHOICE=mistral-small-2506
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

# Local Kuzu storage
KUZU_DB_PATH=./data/kuzu_db

# RAG feature flags
USE_CONTEXTUAL_EMBEDDINGS=true
USE_HYBRID_SEARCH=true
USE_AGENTIC_RAG=true
USE_RERANKING=true

# FlashRank reranking
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=./data/flashrank_cache
RERANKER_MAX_LENGTH=512
